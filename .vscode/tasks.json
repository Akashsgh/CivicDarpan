{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Run ML Service (FastAPI)",
      "type": "shell",
      "command": "python -m uvicorn app:app --host 127.0.0.1 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/ml-service"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "civiclens"
      }
    },
    {
      "label": "2. Run Backend (Express)",
      "type": "shell",
      "command": "node server.js",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "civiclens"
      }
    },
    {
      "label": "3. Run Frontend (React Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "civiclens"
      }
    },
    {
      "label": "Start All Services (CivicLens)",
      "dependsOn": [
        "1. Run ML Service (FastAPI)",
        "2. Run Backend (Express)",
        "3. Run Frontend (React Vite)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
